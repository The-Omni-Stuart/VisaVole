<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for API 31+ (dataExtractionRules).
   Mirrors backup_rules.xml: allowlist of only the user's state file, for
   both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="visavole_state.json"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="visavole_state.json"/>
    </device-transfer>
</data-extraction-rules>
