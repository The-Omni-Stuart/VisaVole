<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto-backup content for API < 31 devices (fullBackupContent).
   An <include> makes this an allowlist: ONLY the user's state file is
   backed up. Everything else (the bundled visa_data.db copies, diagnostic
   quarantine files) is implicitly excluded — the DB is rebuilt from
   assets on launch anyway. The state file holds passport/doc labels,
   dates and trip itineraries; its presence in Google's cloud backup must
   be declared in the Data Safety form.
-->
<full-backup-content>
    <include domain="file" path="visavole_state.json"/>
</full-backup-content>
